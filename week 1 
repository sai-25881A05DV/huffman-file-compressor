
#include <iostream>
#include <vector>
#include <algorithm>

// ======================================================
// DAY 1: CORE DATA STRUCTURES
// ======================================================
struct Node {
    char data;
    unsigned frequency;
    Node *left, *right;

    Node(char data, unsigned frequency) {
        this->data = data;
        this->frequency = frequency;
        left = right = nullptr;
    }
};

class MinHeap {
protected:
    std::vector<Node*> heap;

    // --- DAY 2: Bubble Up ---
    void bubbleUp(int index) {
        if (index == 0) return;
        int parent = (index - 1) / 2;
        if (heap[index]->frequency < heap[parent]->frequency) {
            std::swap(heap[index], heap[parent]);
            bubbleUp(parent);
        }
    }

    // --- DAY 3: Bubble Down ---
    void bubbleDown(int index) {
        int smallest = index;
        int left = 2 * index + 1;
        int right = 2 * index + 2;

        if (left < heap.size() && heap[left]->frequency < heap[smallest]->frequency)
            smallest = left;
        if (right < heap.size() && heap[right]->frequency < heap[smallest]->frequency)
            smallest = right;

        if (smallest != index) {
            std::swap(heap[index], heap[smallest]);
            bubbleDown(smallest);
        }
    }

public:
    MinHeap() {}

    // --- DAY 2: Insert ---
    void insert(Node* node) {
        heap.push_back(node);
        bubbleUp(heap.size() - 1);
    }

    // --- DAY 3: Extract Min ---
    Node* extractMin() {
        if (heap.empty()) return nullptr;
        Node* root = heap[0];
        heap[0] = heap.back();
        heap.pop_back();
        if (!heap.empty()) bubbleDown(0);
        return root;
    }

    // ======================================================
    // DAY 4: NEW HELPER FUNCTIONS & BUILD HEAP
    // ======================================================

    // Day 4: Peek at the minimum without removing it
    Node* getMin() const {
        if (heap.empty()) return nullptr;
        return heap[0];
    }

    // Day 4: Standard size and emptiness helpers
    int size() const { return (int)heap.size(); }
    bool isEmpty() const { return heap.empty(); }

    // Day 4: Build Heap (Heapify)
    // Turns an unsorted vector into a valid MinHeap
    void buildHeap(std::vector<Node*>& nodes) {
        heap = nodes;
        // Start from the last non-leaf node and work up to the root
        for (int i = (heap.size() / 2) - 1; i >= 0; i--) {
            bubbleDown(i);
        }
    }
};