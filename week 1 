
#include <iostream>
#include <vector>
#include <algorithm>

// ======================================================
// CORE DATA STRUCTURES (Day 1)
// ======================================================
struct Node {
    char data;
    unsigned frequency;
    Node *left, *right;

    Node(char data, unsigned frequency) {
        this->data = data;
        this->frequency = frequency;
        left = right = nullptr;
    }
};

class MinHeap {
protected:
    std::vector<Node*> heap;

    // --- Day 2: Bubble Up ---
    void bubbleUp(int index) {
        if (index == 0) return;
        int parent = (index - 1) / 2;
        if (heap[index]->frequency < heap[parent]->frequency) {
            std::swap(heap[index], heap[parent]);
            bubbleUp(parent);
        }
    }

    // --- Day 3: Bubble Down ---
    void bubbleDown(int index) {
        int smallest = index;
        int left = 2 * index + 1;
        int right = 2 * index + 2;

        if (left < heap.size() && heap[left]->frequency < heap[smallest]->frequency)
            smallest = left;
        if (right < heap.size() && heap[right]->frequency < heap[smallest]->frequency)
            smallest = right;

        if (smallest != index) {
            std::swap(heap[index], heap[smallest]);
            bubbleDown(smallest);
        }
    }

public:
    MinHeap() {}

    // Day 2: Insert
    void insert(Node* node) {
        heap.push_back(node);
        bubbleUp(heap.size() - 1);
    }

    // --- Day 3: Extract Min ---
    Node* extractMin() {
        if (heap.empty()) return nullptr;

        Node* root = heap[0];
        heap[0] = heap.back(); // Move last element to root
        heap.pop_back();       // Remove last element

        if (!heap.empty()) {
            bubbleDown(0);     // Restore heap property
        }
        return root;
    }

    // Helpers for verification
    int size() const { return heap.size(); }
    bool isEmpty() const { return heap.empty(); }
};



